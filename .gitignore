# Whitelist: everything is ignored unless allowed below. A new top-level path needs an allow line before its first commit.
/*
!/.gitignore
!/.github/
!/hooks/
!/scripts/
!/spec/
!/src/
!/tests/
!/examples/
!/LICENSE
!/README.md
!/Cargo.toml
!/Cargo.lock

# Denies last (they win over the allows above).
target/
.env*
*.env
*.key
*secret*
*keypair*
*.local.*
.claude/
CLAUDE.md
NEXT.md
wiki/
docs/
